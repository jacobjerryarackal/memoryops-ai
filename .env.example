# ==============================================================================
# MemoryOps AI — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' (for local development) and fill in the values.
# Do NOT commit the '.env' file containing actual secrets to version control!

# ------------------------------------------------------------------------------
# 1. Operational Mode
# ------------------------------------------------------------------------------
# Active environment mode: 'development' (default), 'testing', or 'production'
# In 'production' mode, strict SSL/TLS connection checks are enforced and 
# default postgres credentials are explicitly rejected.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Embedding Provider Selection & Credentials
# ------------------------------------------------------------------------------
# Active provider: 'fallback' (default, offline zero-key setup), 'openai', or 'gemini'
EMBEDDING_PROVIDER=fallback

# OpenAI API key (Required ONLY if EMBEDDING_PROVIDER=openai)
# Must be a valid key starting with 'sk-'
OPENAI_API_KEY=

# Google Gemini API key (Required ONLY if EMBEDDING_PROVIDER=gemini)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Backend Gateway Configuration
# ------------------------------------------------------------------------------
# Port to run the FastAPI Gateway application on (default: 8000).
PORT=8000

# Host to run the FastAPI Gateway application on (default: 127.0.0.1).
HOST=127.0.0.1

# ------------------------------------------------------------------------------
# 4. Database Configuration
# ------------------------------------------------------------------------------
# Active database type: 'memory' (default, local fast development) or 'postgres'
DATABASE_TYPE=memory

# PostgreSQL connection details (used when DATABASE_TYPE=postgres)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database Connection Pool Settings
POSTGRES_MIN_POOL_SIZE=2
POSTGRES_MAX_POOL_SIZE=10
POSTGRES_CONNECTION_TIMEOUT=10.0

# Database SSL Mode: 'disable', 'prefer', 'require', 'verify-ca', 'verify-full'
# In 'production' mode, only secure SSL profiles ('require', 'verify-ca', 'verify-full') are allowed.
POSTGRES_SSL=prefer

# ------------------------------------------------------------------------------
# 5. JWT Authentication Configuration
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JWT tokens. 
# WARNING: Always change this key to a strong random secret in production!
JWT_SECRET=memoryops-jwt-secret-key-change-in-production

# Permitted JWT algorithms. Must be a valid JSON array format.
# A comma-separated string format will fail validation.
JWT_ALGORITHMS=["HS256"]

# Expected issuer and audience claims for incoming JWTs.
JWT_ISSUER=memoryops-ai
JWT_AUDIENCE=memoryops-ai-clients
